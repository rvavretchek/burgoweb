#!/usr/bin/env python3
# /// script
# requires-python = ">=3.11"
# ///
"""Resolve a skill customization surface from base, team and user TOML layers."""

from __future__ import annotations

import argparse
import copy
import json
import sys
import tomllib
from pathlib import Path
from typing import Any


def load_toml(path: Path) -> dict[str, Any]:
    if not path.exists():
        return {}
    with path.open("rb") as stream:
        return tomllib.load(stream)


def keyed_table_array(value: list[Any]) -> str | None:
    if not value or not all(isinstance(item, dict) for item in value):
        return None
    for candidate in ("code", "id"):
        if all(candidate in item for item in value):
            return candidate
    return None


def merge_arrays(base: list[Any], override: list[Any]) -> list[Any]:
    key = keyed_table_array(base) or keyed_table_array(override)
    if key and all(not isinstance(item, dict) or key in item for item in base + override):
        result = copy.deepcopy(base)
        positions = {
            item[key]: index
            for index, item in enumerate(result)
            if isinstance(item, dict) and key in item
        }
        for item in override:
            identity = item[key]
            if identity in positions:
                result[positions[identity]] = copy.deepcopy(item)
            else:
                positions[identity] = len(result)
                result.append(copy.deepcopy(item))
        return result
    return copy.deepcopy(base) + copy.deepcopy(override)


def deep_merge(base: Any, override: Any) -> Any:
    if isinstance(base, dict) and isinstance(override, dict):
        result = copy.deepcopy(base)
        for key, value in override.items():
            result[key] = deep_merge(result[key], value) if key in result else copy.deepcopy(value)
        return result
    if isinstance(base, list) and isinstance(override, list):
        return merge_arrays(base, override)
    return copy.deepcopy(override)


def select(data: dict[str, Any], dotted_key: str) -> Any:
    value: Any = data
    for segment in dotted_key.split("."):
        if not isinstance(value, dict) or segment not in value:
            raise KeyError(dotted_key)
        value = value[segment]
    return value


def find_project_root(start: Path) -> Path:
    for candidate in (start, *start.parents):
        if (candidate / "_bmad").is_dir():
            return candidate
    return Path(__file__).resolve().parents[2]


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--skill", required=True, help="skill root containing customize.toml")
    parser.add_argument("--key", required=True, help="top-level or dotted key to print")
    parser.add_argument("--project-root", help="override project-root discovery")
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    skill = Path(args.skill).resolve()
    if not skill.is_dir():
        print(f"error: skill directory not found: {skill}", file=sys.stderr)
        return 2
    base_path = skill / "customize.toml"
    if not base_path.exists():
        print(f"error: customization surface not found: {base_path}", file=sys.stderr)
        return 2
    root = Path(args.project_root).resolve() if args.project_root else find_project_root(Path.cwd().resolve())
    name = skill.name
    layers = [
        base_path,
        root / "_bmad" / "custom" / f"{name}.toml",
        root / "_bmad" / "custom" / f"{name}.user.toml",
    ]
    try:
        resolved: dict[str, Any] = {}
        for layer in layers:
            resolved = deep_merge(resolved, load_toml(layer))
        value = select(resolved, args.key)
    except (OSError, tomllib.TOMLDecodeError, KeyError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    print(json.dumps(value, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
