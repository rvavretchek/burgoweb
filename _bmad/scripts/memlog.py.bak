#!/usr/bin/env python3
# /// script
# requires-python = ">=3.11"
# ///
"""Atomic append-only memory log used by BMAD workflows.

Supports the current workspace-oriented CLI and the legacy path-oriented CLI.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from datetime import datetime
from pathlib import Path


def now() -> str:
    return datetime.now().astimezone().isoformat(timespec="minutes")


def target(args: argparse.Namespace) -> Path:
    if getattr(args, "path", None):
        return Path(args.path)
    if getattr(args, "workspace", None):
        return Path(args.workspace) / ".memlog.md"
    raise ValueError("one of --path or --workspace is required")


def split_document(text: str) -> tuple[dict[str, str], str]:
    lines = text.splitlines()
    if not lines or lines[0] != "---":
        raise ValueError("memlog has no YAML frontmatter")
    try:
        end = lines.index("---", 1)
    except ValueError as exc:
        raise ValueError("memlog frontmatter is not terminated") from exc
    meta: dict[str, str] = {}
    for line in lines[1:end]:
        if ":" in line:
            key, value = line.split(":", 1)
            meta[key.strip()] = value.strip()
    return meta, "\n".join(lines[end + 1 :]).lstrip("\n")


def render(meta: dict[str, str], body: str) -> str:
    frontmatter = "\n".join(
        f"{key}: {' '.join(str(value).splitlines())}" for key, value in meta.items()
    )
    suffix = body.rstrip("\n")
    return f"---\n{frontmatter}\n---\n\n{suffix}\n"


def touch(meta: dict[str, str]) -> None:
    meta.pop("updated", None)
    meta["updated"] = now()


def write_atomic(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    try:
        with temporary.open("w", encoding="utf-8", newline="\n") as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        if temporary.exists():
            temporary.unlink()


def count_entries(body: str) -> int:
    return sum(line.startswith("- ") for line in body.splitlines())


def acknowledge(path: Path, meta: dict[str, str], body: str, **extra: str) -> None:
    result: dict[str, object] = {
        "ok": True,
        "memlog": str(path),
        "status": meta.get("status", ""),
        "n": count_entries(body),
    }
    result.update(extra)
    print(json.dumps(result, ensure_ascii=False))


def cmd_init(args: argparse.Namespace) -> int:
    path = target(args)
    if path.exists():
        print(f"error: {path} already exists", file=sys.stderr)
        return 2
    meta: dict[str, str] = {}
    for field in args.field or []:
        if "=" not in field:
            print(f"error: --field expects KEY=VALUE, got {field!r}", file=sys.stderr)
            return 2
        key, value = field.split("=", 1)
        key = key.strip()
        if not key:
            print("error: frontmatter key cannot be empty", file=sys.stderr)
            return 2
        meta[key] = " ".join(value.splitlines()).strip()
    meta.setdefault("status", "active")
    touch(meta)
    write_atomic(path, render(meta, ""))
    acknowledge(path, meta, "")
    return 0


def cmd_append(args: argparse.Namespace) -> int:
    path = target(args)
    if not path.exists():
        print(f"error: {path} does not exist; run init first", file=sys.stderr)
        return 2
    meta, body = split_document(path.read_text(encoding="utf-8"))
    text = " ".join(args.text.split())
    if not text:
        print("error: --text cannot be empty", file=sys.stderr)
        return 2
    kind = (args.type or "note").strip()
    if not kind or any(char.isspace() for char in kind):
        print("error: --type must be a non-empty single token", file=sys.stderr)
        return 2
    attribution = f" by {args.by.strip()}" if args.by and args.by.strip() else ""
    entry = f"- ({kind}{attribution}) {text}"
    body = f"{body.rstrip()}\n{entry}" if body.strip() else entry
    touch(meta)
    write_atomic(path, render(meta, body))
    acknowledge(path, meta, body, type=kind)
    return 0


def cmd_set(args: argparse.Namespace) -> int:
    path = target(args)
    if not path.exists():
        print(f"error: {path} does not exist; run init first", file=sys.stderr)
        return 2
    meta, body = split_document(path.read_text(encoding="utf-8"))
    meta[args.key.strip()] = " ".join(args.value.splitlines()).strip()
    touch(meta)
    write_atomic(path, render(meta, body))
    acknowledge(path, meta, body, key=args.key.strip())
    return 0


def cmd_complete(args: argparse.Namespace) -> int:
    args.key = "status"
    args.value = "complete"
    return cmd_set(args)


def add_location(parser: argparse.ArgumentParser) -> None:
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--workspace", help="folder containing .memlog.md")
    group.add_argument("--path", help="explicit memlog path (legacy interface)")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)

    init = commands.add_parser("init")
    add_location(init)
    init.add_argument("--field", action="append", metavar="KEY=VALUE")
    init.set_defaults(func=cmd_init)

    append = commands.add_parser("append")
    add_location(append)
    append.add_argument("--type", default="note")
    append.add_argument("--text", required=True)
    append.add_argument("--by")
    append.set_defaults(func=cmd_append)

    set_value = commands.add_parser("set")
    add_location(set_value)
    set_value.add_argument("--key", required=True)
    set_value.add_argument("--value", required=True)
    set_value.set_defaults(func=cmd_set)

    complete = commands.add_parser("set-complete")
    add_location(complete)
    complete.set_defaults(func=cmd_complete)
    return parser


def main(argv: list[str] | None = None) -> int:
    try:
        args = build_parser().parse_args(argv)
        return args.func(args)
    except (OSError, ValueError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
